 function escape(s: string): string { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }
 function unquote(v: string): string { return /^['"`]/.test(v) ? v.slice(1, -1) : v; }
 
-/** Test files that still carry the old literal beside the constant's name or its module stem. */
-export function consumersOf(repoRoot: string, testFiles: readonly string[], change: ChangedLiteral): string[] {
+/** Find the closing parenthesis without treating nested calls or quoted delimiters as boundaries. */
+function callEnd(text: string, open: number): number {
+  let depth = 0;
+  let quote = '';
+  for (let i = open; i < text.length; i++) {
+    const c = text[i]!;
+    if (quote) {
+      if (c === '\\') i++;
+      else if (c === quote) quote = '';
+      continue;
+    }
+    if (c === '"' || c === "'" || c === '`') { quote = c; continue; }
+    if (c === '/' && text[i + 1] === '/') { const next = text.indexOf('\n', i); if (next < 0) return -1; i = next; continue; }
+    if (c === '/' && text[i + 1] === '*') { const next = text.indexOf('*/', i + 2); if (next < 0) return -1; i = next + 1; continue; }
+    if (c === '(') depth++;
+    else if (c === ')' && --depth === 0) return i;
+  }
+  return -1;
+}
+
+/** Generic option names are not identities: require an associated value, not file-wide co-occurrence. */
+function optionValueLines(text: string, change: ChangedLiteral): Set<number> {
+  const name = new RegExp(`\\b${escape(change.name)}\\b`);
+  const value = new RegExp(`(?<![\\w.])${escape(unquote(change.old))}(?![\\w.])`, 'g');
+  const lines = new Set<number>();
+  const add = (fragment: string, start: number) => {
+    for (const match of fragment.matchAll(value)) lines.add(text.slice(0, start + match.index!).split('\n').length);
+  };
+  const assignment = new RegExp(`\\b${escape(change.name)}\\b["']?\\s*(?::|={1,3}|!==?|>=?|<=?)\\s*(?<![\\w.])${escape(unquote(change.old))}(?![\\w.])`, 'g');
+  for (const match of text.matchAll(assignment)) add(match[0], match.index!);
+  // Parse assertion calls with balanced operands, e.g. expect(getOptions().limit).toBe(10000).
+  for (const match of text.matchAll(/\b(expect|assert(?:\.[a-zA-Z]+)?)\s*\(/g)) {
+    const open = match.index! + match[0].lastIndexOf('(');
+    const end = callEnd(text, open);
+    if (end < 0) { if (name.test(text.slice(open))) add(text.slice(open), open); continue; }
+    const operand = text.slice(open + 1, end);
+    if (!name.test(operand)) continue;
+    if (match[1] !== 'expect') { add(operand, open + 1); continue; }
+    const matcher = /^\s*(?:\.[a-zA-Z]+\s*)+\(/.exec(text.slice(end + 1));
+    if (!matcher) continue;
+    const expectedOpen = end + 1 + matcher[0].lastIndexOf('(');
+    const expectedEnd = callEnd(text, expectedOpen);
+    add(text.slice(expectedOpen + 1, expectedEnd < 0 ? undefined : expectedEnd), expectedOpen + 1);
+  }
+  return lines;
+}
+
+/** Helpers/fixtures also carry expectations; do not restrict provenance to runnable test files. */
+function literalConsumers(graph: Graph, file: string): Set<string> {
+  const seen = new Set<string>([file]);
+  const queue = [file];
+  const dirs = [...graph.reverse.keys()].filter(key => key.endsWith('/**'));
+  for (let i = 0; i < queue.length; i++) {
+    const node = queue[i]!;
+    const edges = [...(graph.reverse.get(node) ?? [])];
+    for (const dir of dirs) if (node.startsWith(dir.slice(0, -3) + '/')) edges.push(...(graph.reverse.get(dir) ?? []));
+    for (const edge of edges) if (!seen.has(edge.from)) { seen.add(edge.from); queue.push(edge.from); }
+  }
+  return seen;
+}
+
+/** Exported symbols retain the whole-tree scan; generic option names need source provenance. */
+export function consumersOf(repoRoot: string, testFiles: readonly string[], change: ChangedLiteral, related?: Set<string>): string[] {
   const value = unquote(change.old);
   const valueRe = /^-?\d/.test(value) ? new RegExp(`(?<![\\w.])${escape(value)}(?![\\w.])`) : new RegExp(`['"\`]${escape(value)}['"\`]`);
   const stem = path.basename(change.file).replace(/\.[^.]+$/, '');
   const nameRe = new RegExp(`\\b${escape(change.name)}\\b`);
   const hits: string[] = [];
+  const generic = /^[a-z]/.test(change.name);
+  const consumers = generic ? related ?? literalConsumers(buildGraph(repoRoot), change.file) : undefined;
   for (const rel of testFiles) {
     let text: string;
     try { text = fs.readFileSync(path.join(repoRoot, rel), 'utf8'); } catch { continue; }
     if (!(nameRe.test(text) || text.includes(stem))) continue;
+    // Explicit source references remain conservative, including subprocess/shell consumers.
+    if (generic && !text.includes(stem)) {
+      if (!consumers!.has(rel)) continue;
+      for (const line of optionValueLines(text, change)) hits.push(`${rel}:${line}`);
+      continue;
+    }
     const lines = text.split('\n');
     for (let i = 0; i < lines.length; i++) if (valueRe.test(lines[i]!)) { hits.push(`${rel}:${i + 1}`); break; }
   }
@@ -90,8 +159,9 @@ function run(ctx: PregateContext): CheckResult {
   if (!changes.length) return { id: 'literals', stage: 'preflight', status: 'pass', inputs, detail: `no exported constant or named timeout literal changed in ${candidates.length} modified source file(s)` };
   const testFiles = listRepoFiles(ctx.repoRoot).filter(f => scansLiterals(f) && !f.startsWith('bin/'));
   const lines: string[] = [];
+  const graph = changes.some(c => /^[a-z]/.test(c.name)) ? buildGraph(ctx.repoRoot, { declarations: ctx.config.dependencies }) : undefined;
   for (const c of changes) {
-    const hits = consumersOf(ctx.repoRoot, testFiles, c);
+    const hits = consumersOf(ctx.repoRoot, testFiles, c, graph ? literalConsumers(graph, c.file) : undefined);
     ctx.explain.push(`literals: ${c.file} ${c.name} ${c.old} → ${c.new}: ${hits.length} test file(s) still carry ${c.old}`);
     for (const h of hits) lines.push(`${h}: ${c.name} still ${c.old} (now ${c.new} in ${c.file})`);
   }
